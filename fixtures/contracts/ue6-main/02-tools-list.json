    {
      "name": "CrashDiagnosticsToolset.CrashDiagnosticsToolset.GetRecentCrashes",
      "description": "Returns summaries of recent Unreal Editor crashes from previous sessions, sorted most-recent-first.\nDoes not include ensures - crashes only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "numberToRetrieve": {
            "type": "integer",
            "description": "Maximum number of summaries to return. Pass 0 or a negative value for no limit.",
            "default": 10
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "array",
            "items": {
              "title": "EditorCrashSummary",
              "type": "object",
              "properties": {
                "crashGUId": {
                  "type": "string",
                  "description": "Unique identifier for this crash."
                },
                "timeOfCrash": {
                  "type": "string",
                  "description": "Time of the crash as \"<local> (UTC: <utc>)\". The local half uses the editor's timezone, not the crash origin's."
                },
                "errorMessage": {
                  "type": "string",
                  "description": "The error message of the crash."
                },
                "crashType": {
                  "type": "string",
                  "description": "The type of crash."
                }
              },
              "required": [
                "crashGUId",
                "timeOfCrash",
                "errorMessage",
                "crashType"
              ]
            },
            "description": "The crash summaries, most recent first."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
